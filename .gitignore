# Python cache
__pycache__/
*.pyc
.pytest_cache/
*.py[cod]
*$py.class
*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environnements virtuels
.venv/
venv/
env/

# Variables d'env
.env
.env.local

# Tests
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/*.log
logs/*.log.*
logs/*.gz
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Données
data/*.csv
data/*.parquet
data/*.json
!data/.gitkeep
# Exceptions : jeu de référence figé + golden run gelé (fiche 517,
# Étape 13.5) — nécessaires pour que le garde-fou CI fonctionne depuis un
# git clone propre, comme le modèle packagé ci-dessous.
!data/reference_set.csv
!data/reference_baseline.json

# Build / distribution
build/
dist/
*.egg-info/

# Modèles trop lourds pour Git (gérer manuellement si < 10 Mo compressé)
models/*.pt
models/*.pth
models/*.joblib
models/*.pkl
models/*.h5
!models/.gitkeep
# Exception : modèle de production packagé (404 Ko), nécessaire pour que
# Docker/CI puissent construire et tester l'API sans dépendre d'un run
!models/trajectoire_emploi_v1.joblib

# Cache HuggingFace
.cache/
~/.cache/huggingface/

# MLflow — artefact local de tracking, régénéré par le script de logging
mlruns/
mlartifacts/

# Docker
.dockerignore
